{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/apps/backend/src/server.ts",
      "envFile": "${workspaceFolder}/apps/backend/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}